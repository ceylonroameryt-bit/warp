# ============================================================
# Warp Ladger — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Warp Ladger"
APP_VERSION=0.1.0
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ─── Security ───────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ─── Database ───────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=warpladger
POSTGRES_USER=warpladger
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql+asyncpg://warpladger:change-me-strong-password@postgres:5432/warpladger

# ─── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── File Storage ───────────────────────────────────────────
# Options: minio | s3 | r2
STORAGE_BACKEND=minio
STORAGE_BUCKET_NAME=warpladger

# MinIO (local development)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# AWS S3 (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=

# Cloudflare R2 (production alternative)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ─── Email ──────────────────────────────────────────────────
# Options: console | smtp
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=noreply@warpladger.com
EMAIL_FROM_NAME="Warp Ladger"

# SMTP (production)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# MailHog (local development override)
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_TLS=false

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120

# ─── Superadmin seed ────────────────────────────────────────
# Used by infrastructure/scripts/seed.py
SEED_SUPERADMIN_EMAIL=admin@warpladger.local
SEED_SUPERADMIN_PASSWORD=change-me-seed-password

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Feature Flags ──────────────────────────────────────────
FEATURE_MFA_ENABLED=false
FEATURE_OAUTH_ENABLED=false
FEATURE_PASSKEYS_ENABLED=false

# ─── Phase 5: Smart Document Capture ──────────────────────────────
# Options: fake | google_document_ai | azure_document_intelligence
DOCUMENT_PROVIDER=fake

# File size limits
DOCUMENT_MAX_IMAGE_SIZE_MB=20
DOCUMENT_MAX_PDF_SIZE_MB=50
DOCUMENT_MAX_PAGES=50

# Google Document AI (production)
GOOGLE_DOCUMENT_AI_PROJECT=
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Confidence thresholds
EXTRACTION_CONFIDENCE_HIGH=0.95
EXTRACTION_CONFIDENCE_MEDIUM=0.80
EXTRACTION_CLASSIFICATION_MIN=0.70

# Duplicate detection scoring
DOCUMENT_DUPLICATE_WARN_SCORE=70
DOCUMENT_DUPLICATE_BLOCK_SCORE=90
